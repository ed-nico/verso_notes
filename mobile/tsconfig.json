{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@vlib/*": ["../src/renderer/src/lib/*"],
      "@shared/*": ["../src/shared/*"]
    }
  },
  "include": ["src", "capacitor.config.ts"]
}
